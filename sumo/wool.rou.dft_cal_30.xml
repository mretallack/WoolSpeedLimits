    <flow id="west_to_east_5" from="348027517" to="--13195" vehsPerHour="25" type="HGV" begin="0" end="3600" />

    <flow id="west_to_east_10" from="4691379#0" to="--13195" vehsPerHour="141" type="CAR" begin="0" end="3600" />

