<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ================================================================
         CALIBRATED-BEHAVIOUR PEAK DEMAND (30mph baseline) — "dft_cal" set
         Continuous speed-factor distribution fitted to DfT SPE0101 (2024):
           30 mph roads: 43% exceed the limit; avg free-flow 30 mph.
         normc(mean, sd, min, max): factor ~ Normal(mean, sd) truncated.
           mean=0.968, sd=0.180  ->  P(factor>1)=43%  (mean speed ~29 mph)
         See Sources/spe0101.ods and DFT_BEHAVIOUR.md.
         Demand volumes = survey-calibrated peak flows (FLOW_CALIBRATION.md).
         ================================================================ -->

    <vType id="MCY" vClass="motorcycle" guiShape="motorcycle" maxSpeed="35.0" speedFactor="1.1" speedDev="0.15" />
    <vType id="BUS" vClass="bus" guiShape="bus" maxSpeed="22.0" speedFactor="0.95" />
    <vType id="LGV" vClass="truck" guiShape="truck" maxSpeed="25.0" speedFactor="1.0" />
    <vType id="HGV" vClass="trailer" guiShape="truck/semitrailer" maxSpeed="22.0" speedFactor="0.9" />

    <!-- Cars: continuous distribution (all cars share one type; speedFactor varies per vehicle) -->
    <vType id="CAR" vClass="passenger" guiShape="passenger" color="0,0,255" maxSpeed="45.0" speedFactor="normc(0.968,0.180,0.2,2.0)" />

    <!-- A352 W->E cars: 518 -->
    <flow id="we_cars" from="348027517" to="--13195" vehsPerHour="518" type="CAR" begin="0" end="3600" departLane="best" departSpeed="max" />
    <flow id="west_to_east_1" from="348027517" to="--13195" vehsPerHour="12" type="MCY" begin="0" end="3600" />
