    <flow id="east_to_west_6" from="-13195" to="-348027517" vehsPerHour="20"  type="CAR_HIGH" begin="0" end="3600" />
    <flow id="east_to_west_2" from="-13195" to="-348027517" vehsPerHour="5"   type="BUS" begin="0" end="3600" />
    <flow id="east_to_west_3" from="-13195" to="-348027517" vehsPerHour="49"  type="LGV" begin="0" end="3600" />
