<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle types with different speed characteristics -->
    <!-- Compliant drivers: max speed capped at 20 mph (~8.94 m/s) or 30 mph (~13.41 m/s) depending on limit, or speedFactor = 1.0 -->
    <vType id="MCY" vClass="motorcycle" guiShape="motorcycle" maxSpeed="35.0"/>
    <vType id="CAR" vClass="passenger" guiShape="passenger" maxSpeed="30.0" speedFactor="1.05"/>
    <vType id="CAR_STRICT" vClass="passenger" guiShape="passenger" color="0,255,0" maxSpeed="8.94" speedFactor="1.0" speedDev="0.0"/>
    <vType id="CAR_SPEEDER" vClass="passenger" guiShape="passenger" color="255,0,0" maxSpeed="40.0" speedFactor="1.3" speedDev="0.1"/>
    
    <vType id="BUS" vClass="bus" guiShape="bus" maxSpeed="22.0"/>
    <vType id="LGV" vClass="truck" guiShape="truck" maxSpeed="25.0"/>
    <vType id="HGV" vClass="trailer" guiShape="truck/semitrailer" maxSpeed="22.0"/>

    <!-- Flows duplicating west_to_east passenger cars with splitting: 10% strict, 70% normal, 20% speeders -->
