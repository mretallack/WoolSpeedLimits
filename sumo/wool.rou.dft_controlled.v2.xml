<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ================================================================
         CORRECTED PEAK (08:00) DEMAND — v2
         Survey-calibrated against SurveyResults.ods, Station Garage,
         06/09/16 08:00 (the survey point INSIDE Wool on the A352):
             W->E : 518 cars, 25 HGV
             E->W : 500 cars, 17 HGV
         Plus the 800-home development feed = 141 cars (README TRICS basis).

         Changes vs wool.rou.dft_controlled.xml:
           * A352 W->E cars 471 -> 518 (survey); split 10/70/20
           * A352 W->E HGV   27 ->  25 (survey)
           * A352 E->W cars 296 -> 500 (survey); split 10/70/20
           * A352 E->W HGV   15 ->  17 (survey)
           * Estate feed    320 -> 141 (800-home figure; was the 1000-home value)
           * Removed duplicated Lulworth legs (2x80) which re-used the estate
             origin edge 4691379#0 and double-counted development traffic.
         ================================================================ -->

    <vType id="MCY" vClass="motorcycle" guiShape="motorcycle" maxSpeed="35.0" speedFactor="1.1" speedDev="0.15" device.rerouting.probability="0.0" />
    <vType id="CAR_COMPLIANT" vClass="passenger" guiShape="passenger" color="0,255,0" maxSpeed="8.94" speedFactor="1.0" speedDev="0.0" device.rerouting.probability="0.0" />
    <vType id="CAR_NORMAL" vClass="passenger" guiShape="passenger" color="0,0,255" maxSpeed="15.0" speedFactor="1.02" speedDev="0.05" device.rerouting.probability="0.0" />
    <vType id="CAR_SPEEADER" vClass="passenger" guiShape="passenger" color="255,0,0" maxSpeed="25.0" speedFactor="1.25" speedDev="0.1" device.rerouting.probability="0.0" />

    <vType id="BUS" vClass="bus" guiShape="bus" maxSpeed="22.0" speedFactor="0.95" device.rerouting.probability="0.0" />
    <vType id="LGV" vClass="truck" guiShape="truck" maxSpeed="25.0" speedFactor="1.0" device.rerouting.probability="0.0" />
    <vType id="HGV" vClass="trailer" guiShape="truck/semitrailer" maxSpeed="22.0" speedFactor="0.9" device.rerouting.probability="0.0" />

    <!-- A352 West -> East through Wool: 518 cars (52 compliant / 363 normal / 103 speeder) -->
    <flow id="we_car_comp" from="348027517" to="--13195" vehsPerHour="52"  type="CAR_COMPLIANT" begin="0" end="3600" departLane="best" departSpeed="max" />
    <flow id="we_car_norm" from="348027517" to="--13195" vehsPerHour="363" type="CAR_NORMAL"    begin="0" end="3600" departLane="best" departSpeed="max" />
    <flow id="we_car_sped" from="348027517" to="--13195" vehsPerHour="103" type="CAR_SPEEADER"   begin="0" end="3600" departLane="best" departSpeed="max" />

    <flow id="west_to_east_1" from="348027517" to="--13195" vehsPerHour="12" type="MCY" begin="0" end="3600" />
    <flow id="west_to_east_3" from="348027517" to="--13195" vehsPerHour="2"  type="BUS" begin="0" end="3600" />
    <flow id="west_to_east_4" from="348027517" to="--13195" vehsPerHour="49" type="LGV" begin="0" end="3600" />
    <flow id="west_to_east_5" from="348027517" to="--13195" vehsPerHour="25" type="HGV" begin="0" end="3600" />

    <!-- New 800-home development: 277 veh/hr x 50.88% Eastbound = 141 cars -->
    <flow id="west_to_east_10" from="4691379#0" to="--13195" vehsPerHour="141" type="CAR_NORMAL" begin="0" end="3600" />

    <!-- South -> North leg (no survey coverage; unchanged) -->
    <flow id="south_to_north_0" from="-143541622" to="-144378564" vehsPerHour="1"  type="MCY" begin="0" end="3600" />
    <flow id="south_to_north_1" from="-143541622" to="-144378564" vehsPerHour="49" type="CAR_NORMAL" begin="0" end="3600" />
    <flow id="south_to_north_2" from="-143541622" to="-144378564" vehsPerHour="2"  type="BUS" begin="0" end="3600" />
    <flow id="south_to_north_3" from="-143541622" to="-144378564" vehsPerHour="5"  type="LGV" begin="0" end="3600" />
    <flow id="south_to_north_4" from="-143541622" to="-144378564" vehsPerHour="1"  type="HGV" begin="0" end="3600" />

    <!-- A352 East -> West through Wool: 500 cars (50 compliant / 350 normal / 100 speeder) -->
    <flow id="east_to_west_0" from="-13195" to="-348027517" vehsPerHour="6"   type="MCY" begin="0" end="3600" />
    <flow id="east_to_west_1" from="-13195" to="-348027517" vehsPerHour="350" type="CAR_NORMAL" begin="0" end="3600" />
    <flow id="east_to_west_5" from="-13195" to="-348027517" vehsPerHour="50"  type="CAR_COMPLIANT" begin="0" end="3600" />
    <flow id="east_to_west_6" from="-13195" to="-348027517" vehsPerHour="100" type="CAR_SPEEADER" begin="0" end="3600" />
    <flow id="east_to_west_2" from="-13195" to="-348027517" vehsPerHour="5"   type="BUS" begin="0" end="3600" />
    <flow id="east_to_west_3" from="-13195" to="-348027517" vehsPerHour="49"  type="LGV" begin="0" end="3600" />
    <flow id="east_to_west_4" from="-13195" to="-348027517" vehsPerHour="17"  type="HGV" begin="0" end="3600" />
</routes>
